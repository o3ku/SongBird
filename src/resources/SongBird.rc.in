// Windows resource script, generated by CMake into the build tree from this template.
// The version fields are substituted from project(VERSION) via SONGBIRD_DISPLAY_VERSION --
// never spelled here (check-version-consistency guards that single source).
//
// The numeric OS/type constants are defined locally instead of including <windows.h>:
// resource compilation does not go through the target's include directories on every
// generator, and the values are stable ABI constants anyway.
#define SONGBIRD_VOS_NT_WINDOWS32 0x00040004L
#define SONGBIRD_VFT_APP 0x00000001L
#define SONGBIRD_VFT2_UNKNOWN 0x00000000L

IDI_APP_ICON ICON "@SONGBIRD_RC_ICON_PATH@"

1 VERSIONINFO
FILEVERSION @SONGBIRD_RC_FILEVERSION@
PRODUCTVERSION @SONGBIRD_RC_FILEVERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS SONGBIRD_VOS_NT_WINDOWS32
FILETYPE SONGBIRD_VFT_APP
FILESUBTYPE SONGBIRD_VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SongBird"
            VALUE "FileDescription", "SongBird"
            VALUE "FileVersion", "@SONGBIRD_RC_FILEVERSION_STRING@"
            VALUE "InternalName", "SongBird.exe"
            VALUE "OriginalFilename", "SongBird.exe"
            VALUE "ProductName", "SongBird"
            VALUE "ProductVersion", "@SONGBIRD_DISPLAY_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
