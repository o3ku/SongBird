<RCC>
    <qresource prefix="/app">
        <file alias="logo.ico">logo.ico</file>
        <file alias="logo.svg">logo.svg</file>
        <file alias="logo-auto.ico">logo-auto.ico</file>
        <file alias="logo-auto.svg">logo-auto.svg</file>
        <file alias="logo-auto-active.svg">logo-auto-active.svg</file>
        <file alias="logo-fire.svg">logo-fire.svg</file>

        <file alias="down.svg">down.svg</file>
        <file alias="up.svg">up.svg</file>
        <file alias="chevron-down.svg">chevron-down.svg</file>
        <file alias="chevron-up.svg">chevron-up.svg</file>
        <file alias="chevron-down-dark.svg">chevron-down-dark.svg</file>
        <file alias="chevron-up-dark.svg">chevron-up-dark.svg</file>
    </qresource>
</RCC>
